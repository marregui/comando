#!/usr/bin/env bash
# Structural checks of the memory directory, the knowledge base, the scratchpad and the indexes of comando's Files tab
# folders (~/.comando/folders.json, $COMANDO_FOLDERS). Read-only. Prints only defects; exit 1 if any.
#
#   index-check [<memory directory>]      default: the autoMemoryDirectory in Claude Code's settings, else MEMORY in
#                                         Claude Code's folder, where the comando kit keeps it
#
# The memory directory is Claude Code's auto-memory directory. MEMORY.md past its budget (160 lines, 20 KB; Claude Code
# loads 200 lines or 25 KB) is a warning: printed, not a defect.
# Env: KB and SCRATCHPAD, by default those folders in Claude Code's folder ($CLAUDE_CONFIG_DIR, else ~/.claude).
set -uo pipefail
shopt -s nullglob
IFS=$'\n'
C=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
K=${KB:-$C/KB}
S=${SCRATCHPAD:-$C/SCRATCHPAD}
bad=0
say() { printf '%s\n' "$1"; bad=1; }

# --- memory ---
configured=$(python3 - "$C/settings.json" 2>/dev/null <<'PY'
import json, os, sys
try:
    v = json.load(open(sys.argv[1], encoding="utf-8-sig")).get("autoMemoryDirectory", "")
except Exception:
    v = ""
print(os.path.expanduser(v) if isinstance(v, str) and v.strip() else "")
PY
)
M=${1:-${configured:-$C/MEMORY}}
if [[ $# -ge 1 || -n $configured || -d $M ]]; then
  if [[ ! -f $M/MEMORY.md ]]; then
    say "memory: no MEMORY.md in $M"
  else
    cd "$M" || exit 2
    for f in *.md; do
      [[ $f == MEMORY.md ]] && continue
      grep -qF "($f)" MEMORY.md || say "memory: $f is not in MEMORY.md"
      [[ $(head -1 "$f") == --- ]] || say "memory: $f has no frontmatter"
    done
    for f in $(grep -oE '\([A-Za-z0-9_.-]+\.md\)' MEMORY.md | tr -d '()' | sort -u); do
      [[ -f $f ]] || say "memory: MEMORY.md points at missing $f"
    done
    bytes=$(wc -c < MEMORY.md | tr -d ' ')
    lines=$(wc -l < MEMORY.md | tr -d ' ')
    if (( bytes > 20480 || lines > 160 )); then
      printf 'warn: MEMORY.md is %s bytes, %s lines: past its budget of 20480 bytes, 160 lines (Claude Code loads 25600, 200)\n' "$bytes" "$lines"
    fi
    # Per-file budget (32 KB), dated logs excepted (they roll by month, below): a file past it takes no addition until an entry of it is merged or archived. A warning.
    big=()
    for f in *.md; do
      [[ $f == MEMORY.md ]] && continue
      (( $(grep -cE '^- (\*\*)?20[0-9]{2}-[0-9]{2}-[0-9]{2}' "$f") >= 20 )) && continue   # a dated log: it rolls by month instead
      b=$(wc -c < "$f" | tr -d ' ')
      (( b > 32768 )) && big+=("$f ($((b / 1024)) KB)")
    done
    if (( ${#big[@]} )); then
      list=$(printf '%s, ' "${big[@]}"); printf 'warn: memory: %s file(s) past the 32 KB file budget, merge before adding: %s\n' "${#big[@]}" "${list%, }"
    fi
    # Dated logs roll by month: lines dated before the previous month belong in archive/<name>_YYYY-MM.md. A warning.
    cutoff=$(python3 -c 'import datetime as d; t = d.date.today().replace(day=1); print((t - d.timedelta(days=1)).replace(day=1))' 2>/dev/null)
    for f in *.md; do
      [[ $f == MEMORY.md || -z $cutoff ]] && continue
      dated=$(grep -cE '^- (\*\*)?20[0-9]{2}-[0-9]{2}-[0-9]{2}' "$f")
      (( dated >= 20 )) || continue   # a dated log, not a file that happens to cite a date
      old=$(grep -oE '^- (\*\*)?20[0-9]{2}-[0-9]{2}-[0-9]{2}' "$f" | grep -oE '20[0-9]{2}-[0-9]{2}-[0-9]{2}' | awk -v c="$cutoff" '$1 < c' | wc -l | tr -d ' ')
      (( old > 0 )) && printf 'warn: memory: %s holds %s line(s) dated before %s: roll them into archive/%s_YYYY-MM.md\n' "$f" "$old" "$cutoff" "${f%.md}"
    done
  fi
fi

# --- knowledge base ---
if [[ -d $K ]]; then
  found=$(python3 -I - "$K" <<'PY'
# The knowledge base is a tree of sets: a folder holding 00_START_HERE.md (its documents, one line each) and
# 99_MAINTENANCE.md (Rules, Source register, Drift check with its checks table, Change log). A document belongs to the
# nearest set at or above its folder; a folder holding SOURCES.md holds raw copies, of which only SOURCES.md is a
# document. One defect per line.
import os, re, sys
kb = os.path.realpath(os.path.expanduser(sys.argv[1]))
ENTRY, MAINT = "00_START_HERE.md", "99_MAINTENANCE.md"
HEADINGS = ["Rules", "Source register", "Drift check", "Change log"]
KINDS = {"code", "document", "web", "toolchain", "slack", "none"}
CADENCES = {"weekly", "monthly", "never"}
CHECKERS = {"kb-drift", "slack-sweep", "none"}

def read(p):
    with open(p, encoding="utf-8", errors="replace") as f:
        return f.read()

def rel(p):
    return os.path.relpath(p, kb)

docs, sets, raw = [], [], set()
for d, subdirs, files in os.walk(kb):
    subdirs[:] = sorted(s for s in subdirs if not s.startswith("."))
    if "SOURCES.md" in files:
        raw.add(d)
    if ENTRY in files or MAINT in files:
        sets.append(d)
    for f in sorted(files):
        if f.endswith(".md") and not f.startswith("."):
            docs.append(os.path.join(d, f))
docs = [p for p in docs if not any(p.startswith(r + os.sep) for r in raw) or os.path.basename(p) == "SOURCES.md"]
setset = set(sets)
if docs and kb not in setset:
    print("KB: the root is not a set: no 00_START_HERE.md")

def owner(path):
    d = os.path.dirname(path)
    while True:
        if d in setset:
            return d
        if d == kb or len(d) < len(kb):
            return None
        d = os.path.dirname(d)

def linked(entry_text, target):
    return f"({target})" in entry_text or f"(./{target})" in entry_text

entries = {}
for s in sets:
    for f in (ENTRY, MAINT):
        if not os.path.isfile(os.path.join(s, f)):
            print(f"KB: set {rel(s)} has no {f}")
    if os.path.isfile(os.path.join(s, ENTRY)):
        entries[s] = read(os.path.join(s, ENTRY))

for s in sets:
    if s == kb:
        continue
    parent = owner(os.path.join(os.path.dirname(s), "x"))
    if parent in entries and not linked(entries[parent], os.path.relpath(os.path.join(s, ENTRY), parent)):
        print(f"KB: set {rel(s)} is not in {rel(os.path.join(parent, ENTRY))}")

for p in docs:
    if os.path.basename(p) == ENTRY and os.path.dirname(p) in setset:
        continue
    o = owner(p)
    if o is None:
        print(f"KB: {rel(p)} belongs to no set")
    elif o in entries and not linked(entries[o], os.path.relpath(p, o)):
        print(f"KB: {rel(p)} is not in {rel(os.path.join(o, ENTRY))}")

for s in sets:
    mp = os.path.join(s, MAINT)
    if not os.path.isfile(mp):
        continue
    text = read(mp)
    titles = [re.sub(r"^\d+(\.\d+)*\.?\s+", "", h).strip() for h in re.findall(r"^## (.+)$", text, re.M)]
    at = 0
    for want in HEADINGS:
        found = next((i for i in range(at, len(titles)) if titles[i].startswith(want)), None)
        if found is None:
            print(f'KB: {rel(mp)} lacks "{want}" (after the ones before it)')
        else:
            at = found + 1
    m = re.search(r"^## (?:\d+\.\s+)?Drift check.*?$(.*?)(?=^## |\Z)", text, re.M | re.S)
    if not m:
        continue
    rows = []
    for l in m.group(1).strip("\n").split("\n"):
        if l.startswith("|"):
            rows.append(l)
        elif rows or l.strip():
            break
    if not rows or not re.match(r"\|\s*Source\s*\|\s*Kind\s*\|\s*Where\s*\|\s*Recorded\s*\|\s*Cadence\s*\|\s*Checker\s*\|", rows[0]):
        print(f"KB: {rel(mp)} Drift check does not open with the checks table")
        continue
    body = [r for r in rows[1:] if not re.match(r"^\|\s*-", r)]
    if not body:
        print(f"KB: {rel(mp)} checks table has no row")
    for r in body:
        cells = [c.strip() for c in r.strip().strip("|").split("|")]
        if len(cells) != 6:
            print(f"KB: {rel(mp)} checks row has {len(cells)} cells, not 6: {r[:60]}")
            continue
        for value, allowed, what in ((cells[1], KINDS, "Kind"), (cells[4], CADENCES, "Cadence"), (cells[5], CHECKERS, "Checker")):
            if value not in allowed:
                print(f'KB: {rel(mp)} checks row "{cells[0]}": {what} "{value}" is not one of {", ".join(sorted(allowed))}')

anchor = re.compile(r"\.(java|kt|kts|py|ts|tsx|js|go|rs|sh|xml|xsd|yaml|yml|gradle|toml|json|md|tf|proto):[0-9]")
memory = re.compile(r"(^|[^A-Za-z/])memory/[A-Za-z0-9_.-]+\.md", re.I | re.M)
for p in docs:
    text = read(p)
    if "Status:" not in "\n".join(text.split("\n")[:8]):
        print(f"KB: {rel(p)} has no Status header")
    if anchor.search(text):
        print(f"KB: {rel(p)} has a file:line anchor")
    if memory.search(text):
        print(f"KB: {rel(p)} references MEMORY/")
    for link in re.findall(r"\]\(([^)#: ]+\.md)", text):
        if not os.path.exists(os.path.join(os.path.dirname(p), link)):
            print(f"KB: dead link {rel(p)} -> {link}")
PY
)
  while IFS= read -r l; do [[ -n $l ]] && say "$l"; done <<< "$found"
fi

# --- scratchpad ---
if [[ -d $S ]]; then
  cd "$S" || exit 2
  for d in *; do
    [[ $d == README.md ]] && continue
    [[ -d $d && $d =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { say "scratchpad: $d is not a YYYY-MM-DD folder"; continue; }
    [[ -f $d/INDEX.md ]] || { say "scratchpad: $d has no INDEX.md"; continue; }
    for a in "$d"/*; do
      a=${a#"$d"/}
      [[ $a == INDEX.md ]] && continue
      [[ $a == work || $a =~ ^READ-[0-9]{2}-.*\.md$ ]] || say "scratchpad: $d/$a is neither a READ-NN- document nor work/"
      grep -qF "\`$a" "$d/INDEX.md" || say "scratchpad: $d/$a is not in its INDEX.md"
    done
  done
fi

# --- comando's folders ---
found=$(python3 -I - "${COMANDO_FOLDERS:-$HOME/.comando/folders.json}" "$C" "$M/MEMORY.md" "$K/00_START_HERE.md" "$S" <<'PY'
# comando's folders.json names more indexes: a folder's `index` lists every entry at its top level, and a deletable
# folder's `listedIn` file, in each subfolder, lists the entries beside it. Folders inside Claude Code's folder only;
# repositories and the indexes checked above (the arguments after the first two) are left out. One defect per line.
import json, os, sys
cfg, claude, *skip = sys.argv[1:]
claude = os.path.realpath(os.path.expanduser(claude))
skip = {os.path.realpath(os.path.expanduser(p)) for p in skip}
always = {"node_modules", "build", "target", "__pycache__", "out"}
try:
    folders = json.load(open(os.path.expanduser(cfg), encoding="utf-8"))
except FileNotFoundError:
    sys.exit(0)
except Exception as e:
    print(f"folders: {cfg} does not read: {e}")
    sys.exit(0)

def entries(d, excludes, own):
    for n in sorted(os.listdir(d)):
        if not (n.startswith(".") or n.lower() in always or n.lower() in excludes or n == own):
            yield n

def listed(text, n):
    return any(s in text for s in (f"({n})", f"({n}/", f"`{n}`", f"`{n}/`"))

def read(p):
    with open(p, encoding="utf-8", errors="replace") as f:
        return f.read()

for f in folders if isinstance(folders, list) else []:
    root = os.path.realpath(os.path.expanduser(f.get("path") or ""))
    if f.get("repository") or not root.startswith(claude + os.sep) or not os.path.isdir(root):
        continue
    name = f.get("name") or root
    excludes = {e.strip().lower() for e in f.get("excludes") or [] if e.strip()}
    index = (f.get("index") or "").strip()
    if index and os.path.realpath(os.path.join(root, index)) not in skip:
        p = os.path.realpath(os.path.join(root, index))
        if not os.path.isfile(p):
            print(f"folders: {name}: its index {index} is missing")
        else:
            text = read(p)
            for n in entries(root, excludes, os.path.basename(p) if os.path.dirname(p) == root else None):
                if not (listed(text, n) or listed(text, os.path.relpath(os.path.join(root, n), os.path.dirname(p)))):
                    print(f"folders: {name}: {n} is not in {index}")
    listing = (f.get("listedIn") or "").strip()
    if f.get("deletable") and listing and root not in skip:
        for d in entries(root, excludes, None):
            sub = os.path.join(root, d)
            if not os.path.isdir(sub) or os.path.islink(sub):
                continue
            kids = list(entries(sub, excludes, listing))
            if not os.path.isfile(os.path.join(sub, listing)):
                if kids:
                    print(f"folders: {name}: {d}/ has no {listing}")
                continue
            text = read(os.path.join(sub, listing))
            for n in kids:
                if not listed(text, n):
                    print(f"folders: {name}: {d}/{n} is not in its {listing}")
PY
)
while IFS= read -r l; do [[ -n $l ]] && say "$l"; done <<< "$found"
exit $bad
