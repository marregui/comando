<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE RSyntaxTheme SYSTEM "theme.dtd">

<!--
	comando's editor theme: the colours of IntelliJ's Dark scheme (the new UI), mapped onto RSyntaxTextArea's token
	types. The DTD resolves from RSyntaxTextArea's own package; see theme.dtd there.
-->
<RSyntaxTheme version="1.0">

	<!--  General editor colors. -->
	<background color="1E1F22" />
	<caret color="CED0D6" />
	<selection useFG="false" bg="214283" roundedEdges="false" />
	<currentLineHighlight color="26282E" fade="false" />
	<marginLine fg="393B40" />
	<markAllHighlight color="32593D" />
	<markOccurrencesHighlight color="373B39" border="false" />
	<matchedBracket fg="BCBEC4" bg="43454A" highlightBoth="true" animate="false" />
	<hyperlinks fg="548AF7" />
	<secondaryLanguages>
		<language index="1" bg="2B2D3A" />
		<language index="2" bg="25302A" />
		<language index="3" bg="352A2C" />
	</secondaryLanguages>

	<!-- Gutter styling. -->
	<gutterBorder color="1E1F22" />
	<lineNumbers fg="4B5059" currentFG="A1A3AB" />
	<foldIndicator fg="6F737A" armedFg="A1A3AB" iconBg="1E1F22" iconArmedBg="2B2D30" />
	<iconRowHeader activeLineRange="3574F0" />

	<!-- Syntax tokens. -->
	<tokenStyles>
		<style token="IDENTIFIER" fg="BCBEC4" />
		<style token="RESERVED_WORD" fg="CF8E6D" />
		<style token="RESERVED_WORD_2" fg="CF8E6D" />
		<style token="ANNOTATION" fg="B3AE60" />
		<style token="COMMENT_DOCUMENTATION" fg="5F826B" italic="true" />
		<style token="COMMENT_EOL" fg="7A7E85" />
		<style token="COMMENT_MULTILINE" fg="7A7E85" />
		<style token="COMMENT_KEYWORD" fg="67A37C" italic="true" />
		<style token="COMMENT_MARKUP" fg="5F826B" italic="true" />
		<style token="FUNCTION" fg="BCBEC4" />
		<style token="DATA_TYPE" fg="CF8E6D" />
		<style token="LITERAL_BOOLEAN" fg="CF8E6D" />
		<style token="LITERAL_NUMBER_DECIMAL_INT" fg="2AACB8" />
		<style token="LITERAL_NUMBER_FLOAT" fg="2AACB8" />
		<style token="LITERAL_NUMBER_HEXADECIMAL" fg="2AACB8" />
		<style token="LITERAL_STRING_DOUBLE_QUOTE" fg="6AAB73" />
		<style token="LITERAL_CHAR" fg="6AAB73" />
		<style token="LITERAL_BACKQUOTE" fg="6AAB73" />
		<style token="MARKUP_TAG_DELIMITER" fg="D5B778" />
		<style token="MARKUP_TAG_NAME" fg="D5B778" />
		<style token="MARKUP_TAG_ATTRIBUTE" fg="BCBEC4" />
		<style token="MARKUP_TAG_ATTRIBUTE_VALUE" fg="6AAB73" />
		<style token="MARKUP_COMMENT" fg="7A7E85" />
		<style token="MARKUP_DTD" fg="D5B778" />
		<style token="MARKUP_PROCESSING_INSTRUCTION" fg="D5B778" />
		<style token="MARKUP_CDATA" fg="BCBEC4" />
		<style token="MARKUP_CDATA_DELIMITER" fg="D5B778" />
		<style token="MARKUP_ENTITY_REFERENCE" fg="2AACB8" />
		<style token="OPERATOR" fg="BCBEC4" />
		<style token="PREPROCESSOR" fg="B3AE60" />
		<style token="REGEX" fg="42C3D4" />
		<style token="SEPARATOR" fg="BCBEC4" />
		<style token="VARIABLE" fg="C77DBB" />
		<style token="WHITESPACE" fg="6F737A" />

		<style token="ERROR_IDENTIFIER" fg="F75464" />
		<style token="ERROR_NUMBER_FORMAT" fg="F75464" />
		<style token="ERROR_STRING_DOUBLE" fg="F75464" />
		<style token="ERROR_CHAR" fg="F75464" />
	</tokenStyles>

</RSyntaxTheme>
