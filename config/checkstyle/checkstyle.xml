<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- A copy of the Java Coding Standard v2.0.3 configuration (marregui/java-standard, config/checkstyle/checkstyle.xml),
     unchanged; update it with the version docs/architecture.md section 9 pins. -->
<!-- The checks of the Java Coding Standard that javac cannot make (STANDARD.md, rule IDs beside each).
     One property is set per repository, from its Apply section (Gradle: checkstyle { configProperties = [...] }):
       projectPackagePattern  required: the project's own packages, e.g. ^dev\.example\.  (G-10.11; without it
                              the project's imports count as third-party and their separate group is reported)
     Checked with Checkstyle 14.3.0. -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <module name="TreeWalker">
        <!-- G-10.11: an import nothing uses; a name used only in Javadoc ({@link}) counts as used -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <!-- G-10.11: no wildcards -->
        <module name="AvoidStarImport"/>
        <!-- G-10.11: JDK, then third-party, then the project's own, then static imports, each sorted. The JDK group is
             the packages the java.* and jdk.* modules of JDK 25 export (java_home/bin/java describe-module), not every
             com.sun package: com.sun.jna and com.sun.activation are third-party. -->
        <module name="CustomImportOrder">
            <property name="customImportOrderRules"
                      value="STANDARD_JAVA_PACKAGE###THIRD_PARTY_PACKAGE###SPECIAL_IMPORTS###STATIC"/>
            <property name="standardPackageRegExp"
                      value="^(java|javax|jdk|sun\.(misc|reflect)|netscape\.javascript|org\.(w3c\.dom|xml\.sax|ietf\.jgss)|com\.sun\.(java\.accessibility|jdi|management|net\.httpserver|nio\.(file|sctp)|security\.(auth|jgss)|source|tools\.(attach|javac|jconsole)))\."/>
            <property name="specialImportsRegExp" value="${projectPackagePattern}" default="^$"/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
        </module>
        <!-- G-10.8: braces always -->
        <module name="NeedBraces"/>
        <!-- G-10.2: final on locals, enhanced-for variables, single-type catch parameters and method and constructor
             parameters never reassigned; a parameter that is reassigned, and the parameters of a method without a body,
             are not reported (FinalParameters, used until 2.0.1, reported every parameter without final). Left to
             review, because FinalLocalVariable does not report them (Checkstyle 14.3.0): fields, try-with-resources
             variables, multi-catch parameters and basic-for initialisers. -->
        <module name="FinalLocalVariable">
            <property name="validateEnhancedForLoopVariable" value="true"/>
            <property name="tokens" value="VARIABLE_DEF,PARAMETER_DEF"/>
        </module>
        <!-- G-10.2: a local declared without an initialiser and assigned later stays bare -->
        <module name="SuppressionXpathSingleFilter">
            <property name="checks" value="FinalLocalVariable"/>
            <property name="query" value="//SLIST/VARIABLE_DEF[not(ASSIGN)]/IDENT"/>
        </module>
    </module>
</module>
